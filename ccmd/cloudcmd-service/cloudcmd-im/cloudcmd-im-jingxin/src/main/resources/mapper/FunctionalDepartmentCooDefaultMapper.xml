<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tdtech.cloudcmd.im.jingxin.server.service.mapper.FunctionalDepartmentCoopDefaultMapper">

    <resultMap id="coopUserResultMap" type="com.tdtech.cloudcmd.im.jingxin.server.entity.CoopUser">
        <id property="id" column="user_id" />
        <result property="name" column="post_name" />
        <result property="uid" column="id" />
        <result column="operate_time" property="operateTime"/>
        <result column="org_name" property="orgName"/>
        <result column="related_user_names" property="relatedUserNames"/>
        <result column="icon_url" property="iconUrl"/>
        <result column="level_name" property="levelName"/>
        <result column="org_id" property="orgId"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, dept_id, user_id, checked, sort, creator, updater, is_deleted, update_time, gmt_created
    </sql>

    <select id="getCoopUsers" resultMap="coopUserResultMap">
        SELECT c.user_id,
               p.post_name,
               c.id,
               p.related_user_names,
               p.org_name,
               c.gmt_created as operate_time,
               p.icon_url,
               p.org_id
        FROM tb_functional_department_coop_default c
        LEFT JOIN tb_collaboration_post p ON c.user_id = p.id
        WHERE c.is_deleted = 0 and p.deleted = 0
        <if test="name !='' and name != null">
            and p.post_name like concat('%', #{name}, '%')
        </if>
        <if test="departments != null and departments.size != 0">
            and p.org_id in
            <foreach collection="departments" item="department" open="(" separator="," close=")">
                #{department}
            </foreach>
        </if>
        order by c.gmt_created desc
    </select>
</mapper>