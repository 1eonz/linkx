<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tdtech.cloudcmd.admin.resource.mapper.PerWarningRalationMapper">
    <sql id="Base_Column_List">
        tb_pre_warning_ralation.id,
        classify,business_id,target_type,
        target_id,business_name,target_name,
        tb_pre_warning_ralation.org_name,id_card
    </sql>

    <select id="selectPerWarningRalationPage"
            resultType="com.tdtech.cloudcmd.admin.resource.entity.dto.PerWarningRalationDO">
        SELECT
        <include refid="Base_Column_List"/>
        <if test="reqVO.classify == 2">
            ,tb_collaboration_post.org_id as orgId
        </if>
        FROM
        icp_res.tb_pre_warning_ralation
        <if test="reqVO.classify == 2">
            left join icp_collabs.tb_collaboration_post on tb_pre_warning_ralation.business_id = tb_collaboration_post.id
        </if>
        <where>
            <if test="reqVO.classify != null">
                AND classify = #{reqVO.classify}
            </if>
            <if test="reqVO.targetType != null">
                AND target_type = #{reqVO.targetType}
            </if>
            <if test="reqVO.targetName != null and reqVO.targetName != ''">
                AND target_name  LIKE CONCAT('%', #{reqVO.targetName}, '%')
            </if>
            <if test="reqVO.businessName != null and reqVO.businessName != ''">
                AND business_name LIKE CONCAT('%', #{reqVO.businessName}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectByBusinessId" resultType="com.tdtech.cloudcmd.admin.resource.entity.dto.PerWarningRalationDO" >
        SELECT <include refid="Base_Column_List"/>
        FROM icp_res.tb_per_warning_ralation
        where business_id = #{businessId}
    </select>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO icp_res.tb_pre_warning_ralation (
        id,
        classify,
        business_id,
        target_type,
        target_id,
        business_name,
        target_name,
        org_name,
        id_card
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id},
            #{item.classify},
            #{item.businessId},
            #{item.targetType},
            #{item.targetId},
            #{item.businessName},
            #{item.targetName},
            #{item.orgName},
            #{item.idCard})
        </foreach>
    </insert>
</mapper>