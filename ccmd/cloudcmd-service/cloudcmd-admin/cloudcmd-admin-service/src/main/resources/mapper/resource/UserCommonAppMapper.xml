<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tdtech.cloudcmd.admin.resource.mapper.UserCommonAppMapper">
    <insert id="saveInitStatus">
        INSERT INTO user_common_app_init (user_id, terminal_type)
        VALUES (#{userId}, #{terminalType})
    </insert>
    <select id="listByUserId" resultType="com.tdtech.cloudcmd.admin.resource.entity.UserCommonAppDO"
            parameterType="java.lang.String">
        SELECT id, user_id, app_id, sort, terminal_type
        FROM user_common_app
        <where>
            <if test="userId != null">
                AND user_id = #{userId} and terminal_type = #{terminalType}
            </if>
        </where>
        GROUP BY app_id
        ORDER BY sort ASC
    </select>
    <select id="getInitStatus" resultType="java.lang.String">
        SELECT user_id
        FROM user_common_app_init
        <where>
            <if test="userId != null">
                AND user_id = #{userId} and terminal_type = #{terminalType}
            </if>
        </where>
        limit 1
    </select>
</mapper>