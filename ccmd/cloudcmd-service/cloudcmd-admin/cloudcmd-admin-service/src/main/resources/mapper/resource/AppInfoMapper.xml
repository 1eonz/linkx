<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tdtech.cloudcmd.admin.resource.mapper.AppInfoMapper">

    <resultMap id="AppInfoDoMap" type="com.tdtech.cloudcmd.admin.resource.entity.dto.AppInfoDO">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="appId" column="app_id" />
        <result property="url" column="uri" />
        <result property="packageAndroid" column="package_android" />
        <result property="packageHm" column="package_hm" />
        <result property="activity" column="activity" />
        <result property="params" column="params" />
        <result property="icon" column="icon" />
        <result property="createTime" column="create_time" />
        <result property="sort" column="sort" />
        <result property="status" column="status" />
        <result property="zone" column="zone" />
        <result property="prerequisite" column="prerequisite" />
        <result property="type" column="type" />
        <result property="isDeleted" column="is_deleted" />
        <!-- 小乔智能体相关字段 -->
        <result property="alias" column="alias" />
        <result property="service" column="service" />
        <result property="headers" column="headers" />
        <result property="body" column="body" />
        <result property="response" column="response" />
        <result property="domain" column="domain" />
        <result property="version" column="version" />
        <result property="description" column="description" />
        <result property="official" column="official" />
        <result property="scope" column="scope" />
    </resultMap>

    <resultMap id="AppInfoMap" type="com.tdtech.cloudcmd.admin.resource.entity.AppInfo">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="appId" column="app_id" />
        <result property="url" column="uri" />
        <result property="packageAndroid" column="package_android" />
        <result property="packageHm" column="package_hm" />
        <result property="activity" column="activity" />
        <result property="params" column="params" />
        <result property="icon" column="icon" />
        <result property="createTime" column="create_time" />
        <result property="sort" column="sort" />
        <result property="status" column="status" />
        <result property="zone" column="zone" />
        <result property="prerequisite" column="prerequisite" />
        <result property="isDeleted" column="is_deleted" />
        <result property="type" column="type" />
        <!-- 小乔智能体相关字段 -->
        <result property="alias" column="alias" />
        <result property="service" column="service" />
        <result property="headers" column="headers" />
        <result property="body" column="body" />
        <result property="response" column="response" />
        <result property="domain" column="domain" />
        <result property="version" column="version" />
        <result property="description" column="description" />
        <result property="official" column="official" />
        <result property="scope" column="scope" />
    </resultMap>

    <select id="selectPage" resultMap="AppInfoDoMap"
            parameterType="com.tdtech.cloudcmd.admin.resource.entity.vo.AppInfoPageReqVO">
        SELECT id, name, app_id, uri, package_android, package_hm, activity, params, icon,
               create_time, sort, status, zone, prerequisite, type, is_deleted,
               alias, service, headers, body, response, domain, version,
               description, official, scope
        FROM app_info
        <where>
            is_deleted = 0
            <if test="reqVO.name != null and reqVO.name != ''">
                AND name LIKE CONCAT('%', #{reqVO.name}, '%')
            </if>
            <if test="reqVO.status != null">
                AND status = #{reqVO.status}
            </if>
        </where>
        ORDER BY sort ASC
    </select>

    <select id="selectInfoById" resultMap="AppInfoMap">
        SELECT id, name, app_id, uri, package_android, package_hm, activity, params, icon,
               create_time, sort, status, zone, prerequisite, type, is_deleted,
               alias, service, headers, body, response, domain, version,
               description, official, scope
        FROM app_info
        WHERE id = #{id} and is_deleted = 0
    </select>

    <select id="selectPrerequisitePage" resultMap="AppInfoDoMap"
    		parameterType="com.tdtech.cloudcmd.admin.resource.entity.vo.AppInfoPageReqVO">
        SELECT id, name, app_id, uri, package_android, package_hm, activity, params, icon,
               create_time, sort, status, zone, prerequisite, type, is_deleted,
               alias, service, headers, body, response, domain, version,
               description, official, scope
        FROM app_info
        <where>
            is_deleted = 0
            AND type = 3
            <if test="reqVO.currentId != null">
                AND id != #{reqVO.currentId}
            </if>
            <if test="reqVO.name != null and reqVO.name != ''">
                AND name LIKE CONCAT('%', #{reqVO.name}, '%')
            </if>
            <if test="reqVO.status != null">
                AND status = #{reqVO.status}
            </if>
        </where>
    </select>

    <select id="selectAppPage" resultMap="AppInfoDoMap">
        SELECT id, name, app_id, uri, package_android, package_hm, activity, params, icon,
               create_time, sort, status, zone, prerequisite, type, is_deleted,
               alias, service, headers, body, response, domain, version,
               description, official, scope
        FROM app_info
        <where>
            is_deleted = 0
            AND type != 3
            <if test="reqVO.name != null and reqVO.name != ''">
                AND name LIKE CONCAT('%', #{reqVO.name}, '%')
            </if>
            <if test="reqVO.status != null">
                AND status = #{reqVO.status}
            </if>
            <if test="reqVO.scope != null">
                AND #{reqVO.scope} &amp; scope = #{reqVO.scope}
            </if>
        </where>
    </select>

    <update id="deleteAllPrerequisite">
        UPDATE app_info
        SET prerequisite = null
        WHERE prerequisite = #{id}
    </update>
</mapper>