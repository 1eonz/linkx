<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tdtech.cloudcmd.admin.resource.mapper.DictionaryTypeMapper">
    <insert id="batchInsertDictionaryType" parameterType="java.util.List">
        INSERT INTO tb_dictionary_type(id, code, name)
        VALUES
        <foreach collection="dictionaryTypeList" item="dictionaryType" separator=",">
            (#{dictionaryType.id},
            #{dictionaryType.code},
            #{dictionaryType.name})
        </foreach>
    </insert>
</mapper>
