<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tdtech.cloudcmd.admin.resource.mapper.RoleToPermissionMapper">

    <select id="getLowerOrganizations" resultType="long">
        select id
        from tb_organization tbo
        where tbo.full_path like concat((select full_path
                                         from tb_organization tbo2
                                         where tbo2.id = #{organizationId}), '%')
    </select>
</mapper>
