#!/usr/bin/env sh
"." 2>/dev/null || true

# AI Code Review — Pre-commit Hook
# 收集暂存区变更 → 写入 .trae/review-pending.json → 暂停提交
# 用户回到 Trae 后，code-review Skill 自动读取并审查

echo ""
echo "🤖 AI Code Review (pre-commit)"

node scripts/ai-code-review.mjs --staged

exit_code=$?

if [ $exit_code -ne 0 ]; then
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "⏸️  提交已暂停！"
  echo ""
  echo "   请在 Trae 对话框中输入「提交代码」完成审查和提交。"
  echo "   禁止直接使用 git commit --no-verify 绕过审查。"
  echo ""
  echo "   如果确实需要紧急跳过，请确认已了解风险后："
  echo "   git commit --no-verify -m \"your message\""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  exit 1
fi

echo ""
echo "✅ AI Code Review 通过，继续提交..."
exit 0
