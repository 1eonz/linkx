{
  "name": "jingxin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite && prepare",
    "build": "vue-tsc --noEmit && vite build",
    "lint:ts": "vue-tsc --noEmit",
    "lint:eslint": "eslint \"src/**/*.{vue,ts,tsx}\" --cache --fix",
    "lint:prettier": "prettier \"src/**/*.{js,json,tsx,css,less,vue,html,md}\" --write --cache --log-level warn",
    "lint:stylelint": "stylelint \"src/**/*.{vue,css,less}\" --fix",
    "lint:lint-staged": "lint-staged",
    "prepare": "husky",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^11.1.0",
    "@vueuse/shared": "^11.1.0",
    "axios": "^1.7.7",
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.4.2",
    "element-plus": "^2.9.5",
    "js-cookie": "^3.0.1",
    "js-md5": "^0.8.3",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.0",
    "pinia": "^2.2.5",
    "qs": "^6.11.2",
    "vue": "^3.5.12",
    "vue-i18n": "^10.0.4",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@cs/commitlint-config": "workspace:*",
    "@cs/eslint-config": "workspace:*",
    "@cs/prettier-config": "workspace:*",
    "@cs/stylelint-config": "workspace:*",
    "@cs/vite-config": "workspace:*",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^22.8.4",
    "@types/qs": "^6.9.7",
    "@vitejs/plugin-vue": "5.1.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.7",
    "fast-glob": "^3.3.2",
    "happy-dom": "^15.11.7",
    "husky": "^9.1.6",
    "less": "^4.2.0",
    "lint-staged": "^15.2.10",
    "rollup": "catalog:",
    "typescript": "^5.6.3",
    "unbuild": "^2.0.0",
    "vite": "catalog:",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.8",
    "vue-types": "^5.1.3",
    "windicss": "^3.5.6"
  },
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9.12.3"
  }
}